# =====================================================================
# Paint Management — Production Planning
# Tracks source (.py), docs (.md), build (.ps1/.bat), config (.ini/.csv).
# Excludes the virtualenv, raw ERP data, derived outputs, and binaries.
# =====================================================================

# ---- Python ----
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Build / binary artifacts ----
*.exe
*.zip
*.pbix
build/
dist/
*.spec

# ---- Raw ERP data (read-only inputs) + derived outputs — never in git ----
/Inventory/
/Inventory P6/
/Releases/
/Process Routings/
/Part Attributes/
/BOM/
/Allocations/
/P10 Planning Data/
/Archive/
/Dashboard/
*.xlsx

# ---- Runtime / derived files ----
# *.log plus rotated backups (foo.log.1) and OneDrive log conflict copies (foo.log-MACHINE.1)
*.log
*.log.*
*.log-*
*_snapshot*.json
# runlist draft: the live file plus OneDrive conflict copies (runlist_draft-MACHINE-N.json)
runlist_draft.json
runlist_draft-*.json
runlist_live.json
Runlists/
Snapshots/
Views/

# `Runlists/` above is matched case-insensitively on Windows (core.ignorecase=true) and at any
# depth, so it ALSO swallowed the SOURCE package `paint_dashboard/runlists/`. Re-include the
# source package's Python files; the runtime `Runlists/` output folder stays ignored.
!**/paint_dashboard/runlists/
!**/paint_dashboard/runlists/*.py

# ---- Plex session credentials — NEVER commit (live cookie, ~4-8h life) ----
plex-session.json
**/plex-session.json
/Plex Access/trial-data/

# ---- OS / OneDrive / editor cruft ----
desktop.ini
.DS_Store
Thumbs.db
.claude/
